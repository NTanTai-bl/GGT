# API and migration configuration for the "local app + RDS" mode.
# Copy this file to .env. The Docker worker uses .env.worker-docker.

# ---- Database ----
# Local dev (Postgres in docker-compose):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pentest_platform
DB_USER=pentest
DB_PASSWORD=pentest
# DB_SSL=false is the implicit default — leave unset for local Postgres.

# Amazon RDS (staging/prod, or local dev pointed at a real RDS instance):
# DB_HOST=<your-instance>.<id>.<region>.rds.amazonaws.com
# DB_USER=...
# DB_PASSWORD=...
# DB_NAME=...
# RDS rejects unencrypted connections by default ("no pg_hba.conf entry
# ... no encryption") — required whenever DB_HOST is an RDS endpoint:
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false
# For real certificate verification instead of the line above, download
# https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem and:
# DB_SSL_CA_PATH=./rds-global-bundle.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

# ---- API ----
API_PORT=4000
SESSION_SECRET=change-me-in-prod
CORS_ORIGIN=http://localhost:5173

# ---- Bootstrap admin (seeded once by packages/database seeders, role=ADMIN) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# ---- AWS / LocalStack (local dev emulates SQS + S3 + Secrets Manager;
#      Bedrock CANNOT be emulated by LocalStack Community — see
#      docs/known-limitations.md) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/pentest-jobs
S3_ARTIFACTS_BUCKET=ggt-pentest-artifacts

# ---- LLM provider (read only by the worker; never sent to the frontend) ----
# GGT production MUST use Bedrock — no Anthropic/OpenAI/OpenRouter key (spec §3/§22):
# STRIX_LLM=bedrock/<approved-claude-model-id>
# LLM_API_KEY=            # leave empty — auth is via the EC2/IAM role
# LLM_API_BASE=

# Local dev default (this machine is not an EC2 instance with an IAM role,
# so real Bedrock auth isn't available here — use a free provider instead):
STRIX_LLM=openrouter/free
LLM_API_KEY=
LLM_API_BASE=

# ---- Strix engine ----
STRIX_BIN=strix
STRIX_TIMEOUT_MS=1800000
STRIX_MAX_BUDGET_USD=3
STRIX_WORKSPACE_ROOT=/opt/ggt/workspaces
# Docker Desktop Windows example. Replace the drive/path with the absolute
# location of this repository. Linux Docker can use an absolute host path.
STRIX_DOCKER_SHARED_DIR=/host_mnt/c/absolute/path/to/GGT/.strix-shared
# STRIX_TELEMETRY is hardcoded to "0" in packages/strix/src/strix-command-builder.ts
# (not read from env) — telemetry can never be silently re-enabled by config drift.

# ---- Worker ----
WORKER_POLL_INTERVAL_MS=5000
WORKER_VISIBILITY_TIMEOUT_SEC=1800

# ---- Jira (Phase 2, unused in v1) ----
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# ---- Slack (Phase 2, unused in v1) ----
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
