# Docker worker configuration for local development with Amazon RDS.
# Copy this file to .env.worker-docker. Never commit the copied file.

# ---- Amazon RDS PostgreSQL ----
DB_HOST=<your-instance>.<id>.<region>.rds.amazonaws.com
DB_PORT=5432
DB_NAME=ggtdb
DB_USER=<rds-app-user>
DB_PASSWORD=<rds-password>
DB_SSL=true
# docker-compose.local-rds.yml mounts ./certs at /certs in the container.
DB_SSL_CA_PATH=/certs/rds-global-bundle.pem
DB_SSL_REJECT_UNAUTHORIZED=true

# ---- LocalStack, accessed from inside the Docker network ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
SQS_QUEUE_URL=http://localstack:4566/000000000000/pentest-jobs
S3_ARTIFACTS_BUCKET=ggt-pentest-artifacts
# The AWS SDKs (Node and boto3/litellm used by Strix) apply AWS_ENDPOINT_URL to
# EVERY AWS service, including Bedrock. When STRIX_LLM=bedrock/... or the AI
# reviewer uses Bedrock, point Bedrock at the real endpoint explicitly:
# AWS_ENDPOINT_URL_BEDROCK_RUNTIME=https://bedrock-runtime.us-east-1.amazonaws.com

# ---- LLM / Strix: Worker only; never copy these values into the Web/API env ----
STRIX_LLM=openrouter/free
LLM_API_KEY=<openrouter-api-key>
LLM_API_BASE=https://openrouter.ai/api/v1
STRIX_BIN=/opt/strix-venv/bin/strix
STRIX_TIMEOUT_MS=1800000
STRIX_MAX_BUDGET_USD=3
STRIX_WORKSPACE_ROOT=/opt/ggt/workspaces
# Local troubleshooting only: stream Strix stdout/stderr into Docker logs.
STRIX_STREAM_LOGS=true
# docker-compose.local-rds.yml sets STRIX_DOCKER_SANDBOX_NETWORK=ggt-strix
# and attaches the worker to that network so it can reach Caido in the
# sibling Strix sandbox container.

# ---- Independent AI finding review ----
AI_REVIEW_ENABLED=false
AI_REVIEW_PROVIDER=bedrock
AI_REVIEW_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Bedrock uses the worker's AWS IAM credentials. Leave this empty for Bedrock.
AI_REVIEW_API_KEY=
AI_REVIEW_MAX_INPUT_CHARS=60000
AI_REVIEW_MAX_OUTPUT_TOKENS=2500
AI_REVIEW_MAX_FINDINGS=50
AI_REVIEW_MAX_BUDGET_USD=1
AI_REVIEW_PROMPT_VERSION=v1
# Configure current provider prices if GGT should enforce an estimated USD cap.
# AI_REVIEW_INPUT_COST_PER_MILLION_USD=
# AI_REVIEW_OUTPUT_COST_PER_MILLION_USD=

# ---- Worker ----
WORKER_POLL_INTERVAL_MS=5000
# Must exceed STRIX_TIMEOUT_MS (in seconds) plus AI review time.
WORKER_VISIBILITY_TIMEOUT_SEC=3600
# How often a running scan checks whether it was cancelled from the UI (ms).
WORKER_CANCEL_POLL_INTERVAL_MS=10000
