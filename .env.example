# ---- Database ----
DATABASE_URL=postgres://pentest:pentest@localhost:5432/pentest_platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pentest_platform
DB_USER=pentest
DB_PASSWORD=pentest

# ---- API ----
API_PORT=4000
SESSION_SECRET=change-me-in-prod
CORS_ORIGIN=http://localhost:5173

# ---- Bootstrap admin (seeded once by packages/database seeders) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# ---- AWS / LocalStack (local dev emulates SQS + S3) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/pentest-requests
S3_ARTIFACTS_BUCKET=pentest-artifacts

# ---- LLM provider (read only by the worker; never sent to the frontend) ----
# Dev default — no Anthropic key required:
STRIX_LLM=openrouter/free
LLM_API_KEY=
LLM_API_BASE=

# Claude example (swap in when an Anthropic key is available):
# STRIX_LLM=anthropic/claude-sonnet-4-6
# LLM_API_KEY=sk-ant-...
# LLM_API_BASE=

# AWS Bedrock example (future):
# STRIX_LLM=bedrock/anthropic.claude-4-5-sonnet-20251022-v1:0
# LLM_API_KEY=
# LLM_API_BASE=

# ---- Strix engine ----
STRIX_BIN=strix
STRIX_TIMEOUT_MS=1800000

# ---- Worker ----
WORKER_POLL_INTERVAL_MS=5000
WORKER_VISIBILITY_TIMEOUT_SEC=1800

# ---- Jira (Phase 2, unused in Phase 1) ----
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# ---- Slack (Phase 2, unused in Phase 1) ----
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
