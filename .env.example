# ---- Database ----
DATABASE_URL=postgres://pentest:pentest@localhost:5432/pentest_platform
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pentest_platform
DB_USER=pentest
DB_PASSWORD=pentest

# ---- API ----
API_PORT=4000
SESSION_SECRET=change-me-in-prod
CORS_ORIGIN=http://localhost:5173

# ---- Bootstrap admin (seeded once by packages/database seeders, role=ADMIN) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# ---- AWS / LocalStack (local dev emulates SQS + S3 + Secrets Manager;
#      Bedrock CANNOT be emulated by LocalStack Community — see
#      docs/known-limitations.md) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/pentest-jobs
S3_ARTIFACTS_BUCKET=ggt-pentest-artifacts

# ---- LLM provider (read only by the worker; never sent to the frontend) ----
# GGT production MUST use Bedrock — no Anthropic/OpenAI/OpenRouter key (spec §3/§22):
# STRIX_LLM=bedrock/<approved-claude-model-id>
# LLM_API_KEY=            # leave empty — auth is via the EC2/IAM role
# LLM_API_BASE=

# Local dev default (this machine is not an EC2 instance with an IAM role,
# so real Bedrock auth isn't available here — use a free provider instead):
STRIX_LLM=openrouter/free
LLM_API_KEY=
LLM_API_BASE=

# ---- Strix engine ----
STRIX_BIN=strix
STRIX_TIMEOUT_MS=1800000
STRIX_WORKSPACE_ROOT=/opt/ggt/workspaces
# STRIX_TELEMETRY is hardcoded to "0" in packages/strix/src/strix-command-builder.ts
# (not read from env) — telemetry can never be silently re-enabled by config drift.

# ---- Worker ----
WORKER_POLL_INTERVAL_MS=5000
WORKER_VISIBILITY_TIMEOUT_SEC=1800

# ---- Jira (Phase 2, unused in v1) ----
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# ---- Slack (Phase 2, unused in v1) ----
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
